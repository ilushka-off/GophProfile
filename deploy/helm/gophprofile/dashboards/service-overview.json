      "type": "logs",
      "title": "Ошибки server и worker",
      "description": "Строки уровня ERROR из Loki. trace_id в строке — ссылка на трейс.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
