          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(avatars_uploads_total{status=~\"rejected|error\"}[5m])) / clamp_min(sum(rate(avatars_uploads_total[5m])), 1e-9)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
