# --- Запуск через Docker Compose  ---
POSTGRES_DB=gophprofile
POSTGRES_USER=gophprofile
POSTGRES_PASSWORD=gophprofile
POSTGRES_PORT=5432

S3_ACCESS_KEY=gophprofile
S3_SECRET_KEY=gophprofile-secret
S3_BUCKET=avatars
S3_PORT=8333
S3_FILER_PORT=8888

RABBITMQ_USER=gophprofile
RABBITMQ_PASSWORD=gophprofile
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

KAFKA_EXTERNAL_PORT=9094

APP_PORT=8080

# Профиль observability.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
LOKI_PORT=3100
ALLOY_PORT=12345
CADVISOR_PORT=8081
KAFKA_EXPORTER_PORT=9308
ALERTMANAGER_PORT=9093
OTEL_TRACES_SAMPLER_ARG=1
# Профиль docker compose для make up/down/logs и брокер для локального запуска.
# В самом compose брокер задаёт профиль: --profile rabbitmq или --profile kafka.
BROKER=rabbitmq
LOG_LEVEL=info
MAX_UPLOAD_SIZE=10485760
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Origins через запятую для CORS, например https://app.example. Пусто — выключен.
CORS_ALLOWED_ORIGINS=

# --- Локальный запуск (GoLand / make run) ---
HTTP_ADDR=:8080
DATABASE_URI=postgres://gophprofile:gophprofile@localhost:5432/gophprofile?sslmode=disable
S3_ENDPOINT=localhost:8333
S3_REGION=us-east-1
S3_USE_SSL=false
RABBITMQ_URL=amqp://gophprofile:gophprofile@localhost:5672/
KAFKA_BROKERS=localhost:9094
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
