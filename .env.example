# --- Запуск через Docker Compose  ---
POSTGRES_DB=gophprofile
POSTGRES_USER=gophprofile
POSTGRES_PASSWORD=gophprofile
POSTGRES_PORT=5432

S3_ACCESS_KEY=gophprofile
S3_SECRET_KEY=gophprofile-secret
S3_BUCKET=avatars
S3_PORT=8333
S3_FILER_PORT=8888

RABBITMQ_USER=gophprofile
RABBITMQ_PASSWORD=gophprofile
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

KAFKA_EXTERNAL_PORT=9094

APP_PORT=8080
BROKER=rabbitmq
LOG_LEVEL=info
MAX_UPLOAD_SIZE=10485760

# --- Локальный запуск (GoLand / make run) ---
HTTP_ADDR=:8080
DATABASE_URI=postgres://gophprofile:gophprofile@localhost:5432/gophprofile?sslmode=disable
S3_ENDPOINT=localhost:8333
S3_REGION=us-east-1
S3_USE_SSL=false
RABBITMQ_URL=amqp://gophprofile:gophprofile@localhost:5672/
KAFKA_BROKERS=localhost:9094
